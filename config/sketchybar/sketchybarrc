                              icon.color=0xff1DB954                   \
                              icon.padding_left=4                     \
                              icon.padding_right=4                    \
                              label.drawing=off                       \
                              drawing=off                             \
                              script="$PLUGIN_DIR/spotify.sh"         \
           --subscribe spotify.play mouse.clicked spotify_change      \
                                                                      \
           --add item spotify.back right                              \
           --set spotify.back icon=󰒮                                   \
